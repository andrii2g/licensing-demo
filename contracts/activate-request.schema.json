{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "title": "activate-request",
  "type": "object",
  "properties": {
    "schema_version": {
      "const": 1
    },
    "action": {
      "const": "activate"
    },
    "operation_id": {
      "type": "string",
      "minLength": 1,
      "maxLength": 36,
      "pattern": "^[0-9a-f]{8}-[0-9a-f]{4}-4[0-9a-f]{3}-[89ab][0-9a-f]{3}-[0-9a-f]{12}$"
    },
    "challenge_id": {
      "type": "string",
      "minLength": 1,
      "maxLength": 36,
      "pattern": "^[0-9a-f]{8}-[0-9a-f]{4}-4[0-9a-f]{3}-[89ab][0-9a-f]{3}-[0-9a-f]{12}$"
    },
    "nonce": {
      "type": "string",
      "minLength": 1,
      "maxLength": 43,
      "pattern": "^[A-Za-z0-9_-]{43}$"
    },
    "installation_id": {
      "type": "string",
      "minLength": 1,
      "maxLength": 36,
      "pattern": "^[0-9a-f]{8}-[0-9a-f]{4}-4[0-9a-f]{3}-[89ab][0-9a-f]{3}-[0-9a-f]{12}$"
    },
    "product": {
      "type": "string",
      "minLength": 1,
      "maxLength": 64,
      "pattern": "^[a-zA-Z0-9][a-zA-Z0-9._-]*$"
    },
    "installation_public_key": {
      "type": "string",
      "minLength": 1,
      "maxLength": 43,
      "pattern": "^[A-Za-z0-9_-]{43}$"
    },
    "inventory": {
      "$ref": "inventory.schema.json"
    }
  },
  "required": [
    "schema_version",
    "action",
    "operation_id",
    "challenge_id",
    "nonce",
    "installation_id",
    "product",
    "installation_public_key",
    "inventory"
  ],
  "additionalProperties": false
}
