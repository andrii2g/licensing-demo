{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "title": "license-claims",
  "type": "object",
  "properties": {
    "schema_version": {
      "const": 1
    },
    "issuer": {
      "const": "license-guard"
    },
    "license_id": {
      "type": "string",
      "minLength": 1,
      "maxLength": 64,
      "pattern": "^[a-zA-Z0-9][a-zA-Z0-9._-]*$"
    },
    "customer_id": {
      "type": "string",
      "minLength": 1,
      "maxLength": 64,
      "pattern": "^[a-zA-Z0-9][a-zA-Z0-9._-]*$"
    },
    "product": {
      "type": "string",
      "minLength": 1,
      "maxLength": 64,
      "pattern": "^[a-zA-Z0-9][a-zA-Z0-9._-]*$"
    },
    "installation_id": {
      "type": "string",
      "minLength": 1,
      "maxLength": 36,
      "pattern": "^[0-9a-f]{8}-[0-9a-f]{4}-4[0-9a-f]{3}-[89ab][0-9a-f]{3}-[0-9a-f]{12}$"
    },
    "installation_public_key_sha256": {
      "type": "string",
      "minLength": 1,
      "maxLength": 64,
      "pattern": "^[0-9a-f]{64}$"
    },
    "sequence": {
      "type": "integer",
      "minimum": 1,
      "maximum": 9007199254740991
    },
    "issued_at": {
      "type": "integer",
      "minimum": 0,
      "maximum": 4102444800
    },
    "not_before": {
      "type": "integer",
      "minimum": 0,
      "maximum": 4102444800
    },
    "lease_valid_until": {
      "type": "integer",
      "minimum": 0,
      "maximum": 4102444800
    },
    "entitlement_expires_at": {
      "type": "integer",
      "minimum": 0,
      "maximum": 4102444800
    },
    "mode": {
      "enum": [
        "renewable",
        "manual_offline"
      ]
    },
    "features": {
      "type": "array",
      "items": {
        "type": "string",
        "minLength": 1,
        "maxLength": 64,
        "pattern": "^[a-zA-Z0-9][a-zA-Z0-9._-]*$"
      },
      "minItems": 1,
      "maxItems": 64,
      "uniqueItems": true
    },
    "binding": {
      "type": "object",
      "properties": {
        "policy": {
          "enum": [
            "linux-host-v1",
            "linux-machine-v1"
          ]
        },
        "machine_id_hash": {
          "type": "string",
          "minLength": 1,
          "maxLength": 64,
          "pattern": "^[0-9a-f]{64}$"
        },
        "system_uuid_hash": {
          "anyOf": [
            {
              "type": "string",
              "minLength": 1,
              "maxLength": 64,
              "pattern": "^[0-9a-f]{64}$"
            },
            {
              "type": "null"
            }
          ]
        }
      },
      "required": [
        "policy",
        "machine_id_hash",
        "system_uuid_hash"
      ],
      "additionalProperties": false,
      "allOf": [
        {
          "if": {
            "properties": {
              "policy": {
                "const": "linux-host-v1"
              }
            }
          },
          "then": {
            "properties": {
              "system_uuid_hash": {
                "type": "string",
                "minLength": 1,
                "maxLength": 64,
                "pattern": "^[0-9a-f]{64}$"
              }
            }
          },
          "else": {
            "properties": {
              "system_uuid_hash": {
                "type": "null"
              }
            }
          }
        }
      ]
    },
    "max_logical_processors": {
      "anyOf": [
        {
          "type": "integer",
          "minimum": 1,
          "maximum": 1048576
        },
        {
          "type": "null"
        }
      ]
    }
  },
  "required": [
    "schema_version",
    "issuer",
    "license_id",
    "customer_id",
    "product",
    "installation_id",
    "installation_public_key_sha256",
    "sequence",
    "issued_at",
    "not_before",
    "lease_valid_until",
    "entitlement_expires_at",
    "mode",
    "features",
    "binding",
    "max_logical_processors"
  ],
  "additionalProperties": false
}
