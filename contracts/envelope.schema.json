{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "title": "envelope",
  "type": "object",
  "properties": {
    "protected": {
      "type": "string",
      "minLength": 1,
      "maxLength": 1366,
      "pattern": "^[A-Za-z0-9_-]+$"
    },
    "payload": {
      "type": "string",
      "minLength": 1,
      "maxLength": 65536,
      "pattern": "^[A-Za-z0-9_-]+$"
    },
    "signature": {
      "type": "string",
      "minLength": 1,
      "maxLength": 86,
      "pattern": "^[A-Za-z0-9_-]{86}$"
    }
  },
  "required": [
    "protected",
    "payload",
    "signature"
  ],
  "additionalProperties": false
}
