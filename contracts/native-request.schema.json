{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "title": "native-request",
  "type": "object",
  "properties": {
    "schema_version": {
      "const": 1
    },
    "license_path": {
      "type": "string",
      "minLength": 1,
      "maxLength": 4096,
      "pattern": "^/"
    },
    "identity_path": {
      "type": "string",
      "minLength": 1,
      "maxLength": 4096,
      "pattern": "^/"
    },
    "product": {
      "type": "string",
      "minLength": 1,
      "maxLength": 64,
      "pattern": "^[a-zA-Z0-9][a-zA-Z0-9._-]*$"
    },
    "required_features": {
      "type": "array",
      "items": {
        "type": "string",
        "minLength": 1,
        "maxLength": 64,
        "pattern": "^[a-zA-Z0-9][a-zA-Z0-9._-]*$"
      },
      "minItems": 0,
      "maxItems": 16,
      "uniqueItems": true
    }
  },
  "required": [
    "schema_version",
    "license_path",
    "identity_path",
    "product",
    "required_features"
  ],
  "additionalProperties": false
}
