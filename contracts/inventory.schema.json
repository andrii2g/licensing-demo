{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "title": "inventory",
  "type": "object",
  "properties": {
    "schema_version": {
      "const": 1
    },
    "collected_at": {
      "type": "integer",
      "minimum": 0,
      "maximum": 4102444800
    },
    "hostname": {
      "type": "string",
      "minLength": 1,
      "maxLength": 253
    },
    "network_interfaces": {
      "type": "array",
      "items": {
        "type": "object",
        "properties": {
          "name": {
            "type": "string",
            "minLength": 1,
            "maxLength": 64
          },
          "mac": {
            "type": "string",
            "minLength": 1,
            "maxLength": 17,
            "pattern": "^([0-9a-f]{2}:){5}[0-9a-f]{2}$"
          },
          "kind": {
            "enum": [
              "physical",
              "virtual",
              "unknown"
            ]
          }
        },
        "required": [
          "name",
          "mac",
          "kind"
        ],
        "additionalProperties": false
      },
      "maxItems": 64
    },
    "cpu": {
      "type": "object",
      "properties": {
        "model": {
          "anyOf": [
            {
              "type": "string",
              "minLength": 1,
              "maxLength": 256
            },
            {
              "type": "null"
            }
          ]
        },
        "sockets": {
          "anyOf": [
            {
              "type": "integer",
              "minimum": 1,
              "maximum": 1048576
            },
            {
              "type": "null"
            }
          ]
        },
        "cores": {
          "anyOf": [
            {
              "type": "integer",
              "minimum": 1,
              "maximum": 1048576
            },
            {
              "type": "null"
            }
          ]
        },
        "logical_processors": {
          "anyOf": [
            {
              "type": "integer",
              "minimum": 1,
              "maximum": 1048576
            },
            {
              "type": "null"
            }
          ]
        },
        "available_logical_processors": {
          "anyOf": [
            {
              "type": "integer",
              "minimum": 1,
              "maximum": 1048576
            },
            {
              "type": "null"
            }
          ]
        }
      },
      "required": [
        "model",
        "sockets",
        "cores",
        "logical_processors",
        "available_logical_processors"
      ],
      "additionalProperties": false
    },
    "os": {
      "type": "object",
      "properties": {
        "id": {
          "type": "string",
          "minLength": 1,
          "maxLength": 64
        },
        "version": {
          "anyOf": [
            {
              "type": "string",
              "minLength": 1,
              "maxLength": 256
            },
            {
              "type": "null"
            }
          ]
        },
        "kernel": {
          "type": "string",
          "minLength": 1,
          "maxLength": 256
        },
        "architecture": {
          "type": "string",
          "minLength": 1,
          "maxLength": 64
        }
      },
      "required": [
        "id",
        "version",
        "kernel",
        "architecture"
      ],
      "additionalProperties": false
    },
    "virtualization": {
      "enum": [
        "physical",
        "vmware",
        "other",
        "unknown"
      ]
    },
    "machine_id_hash": {
      "type": "string",
      "minLength": 1,
      "maxLength": 64,
      "pattern": "^[0-9a-f]{64}$"
    },
    "system_uuid_hash": {
      "anyOf": [
        {
          "type": "string",
          "minLength": 1,
          "maxLength": 64,
          "pattern": "^[0-9a-f]{64}$"
        },
        {
          "type": "null"
        }
      ]
    }
  },
  "required": [
    "schema_version",
    "collected_at",
    "hostname",
    "network_interfaces",
    "cpu",
    "os",
    "virtualization",
    "machine_id_hash",
    "system_uuid_hash"
  ],
  "additionalProperties": false
}
