{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "title": "native-result",
  "type": "object",
  "properties": {
    "schema_version": {
      "const": 1
    },
    "valid": {
      "type": "boolean"
    },
    "code": {
      "enum": [
        "VALID",
        "LICENSE_MISSING",
        "LICENSE_MALFORMED",
        "UNSUPPORTED_FORMAT",
        "UNKNOWN_KEY",
        "INVALID_SIGNATURE",
        "PRODUCT_MISMATCH",
        "FEATURE_MISSING",
        "INSTALLATION_MISMATCH",
        "NOT_YET_VALID",
        "CLOCK_SUSPECT",
        "LICENSE_EXPIRED",
        "IDENTITY_UNAVAILABLE",
        "MACHINE_MISMATCH",
        "CAPACITY_EXCEEDED",
        "CAPACITY_UNAVAILABLE",
        "IO_ERROR",
        "LEASE_ROLLBACK",
        "INTERNAL_ERROR"
      ]
    },
    "checked_at": {
      "type": "integer",
      "minimum": 0,
      "maximum": 4102444800
    },
    "license_id": {
      "anyOf": [
        {
          "type": "string",
          "minLength": 1,
          "maxLength": 64,
          "pattern": "^[a-zA-Z0-9][a-zA-Z0-9._-]*$"
        },
        {
          "type": "null"
        }
      ]
    },
    "installation_id": {
      "anyOf": [
        {
          "type": "string",
          "minLength": 1,
          "maxLength": 36,
          "pattern": "^[0-9a-f]{8}-[0-9a-f]{4}-4[0-9a-f]{3}-[89ab][0-9a-f]{3}-[0-9a-f]{12}$"
        },
        {
          "type": "null"
        }
      ]
    },
    "sequence": {
      "anyOf": [
        {
          "type": "integer",
          "minimum": 1,
          "maximum": 9007199254740991
        },
        {
          "type": "null"
        }
      ]
    },
    "lease_valid_until": {
      "anyOf": [
        {
          "type": "integer",
          "minimum": 0,
          "maximum": 4102444800
        },
        {
          "type": "null"
        }
      ]
    },
    "entitlement_expires_at": {
      "anyOf": [
        {
          "type": "integer",
          "minimum": 0,
          "maximum": 4102444800
        },
        {
          "type": "null"
        }
      ]
    },
    "features": {
      "type": "array",
      "items": {
        "type": "string",
        "minLength": 1,
        "maxLength": 64,
        "pattern": "^[a-zA-Z0-9][a-zA-Z0-9._-]*$"
      },
      "minItems": 0,
      "maxItems": 64,
      "uniqueItems": true
    },
    "lease_digest": {
      "anyOf": [
        {
          "type": "string",
          "minLength": 1,
          "maxLength": 64,
          "pattern": "^[0-9a-f]{64}$"
        },
        {
          "type": "null"
        }
      ]
    }
  },
  "required": [
    "schema_version",
    "valid",
    "code",
    "checked_at",
    "license_id",
    "installation_id",
    "sequence",
    "lease_valid_until",
    "entitlement_expires_at",
    "features",
    "lease_digest"
  ],
  "additionalProperties": false,
  "allOf": [
    {
      "if": {
        "properties": {
          "valid": {
            "const": true
          }
        }
      },
      "then": {
        "properties": {
          "code": {
            "const": "VALID"
          },
          "license_id": {
            "not": {
              "type": "null"
            }
          },
          "installation_id": {
            "not": {
              "type": "null"
            }
          },
          "sequence": {
            "not": {
              "type": "null"
            }
          },
          "lease_valid_until": {
            "not": {
              "type": "null"
            }
          },
          "entitlement_expires_at": {
            "not": {
              "type": "null"
            }
          },
          "lease_digest": {
            "not": {
              "type": "null"
            }
          }
        }
      },
      "else": {
        "properties": {
          "code": {
            "not": {
              "const": "VALID"
            }
          },
          "features": {
            "maxItems": 0
          },
          "license_id": {
            "type": "null"
          },
          "installation_id": {
            "type": "null"
          },
          "sequence": {
            "type": "null"
          },
          "lease_valid_until": {
            "type": "null"
          },
          "entitlement_expires_at": {
            "type": "null"
          },
          "lease_digest": {
            "type": "null"
          }
        }
      }
    }
  ]
}
