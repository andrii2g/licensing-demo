{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "title": "challenge-response",
  "type": "object",
  "properties": {
    "schema_version": {
      "const": 1
    },
    "challenge_id": {
      "type": "string",
      "minLength": 1,
      "maxLength": 36,
      "pattern": "^[0-9a-f]{8}-[0-9a-f]{4}-4[0-9a-f]{3}-[89ab][0-9a-f]{3}-[0-9a-f]{12}$"
    },
    "nonce": {
      "type": "string",
      "minLength": 1,
      "maxLength": 43,
      "pattern": "^[A-Za-z0-9_-]{43}$"
    },
    "expires_at": {
      "type": "integer",
      "minimum": 0,
      "maximum": 4102444800
    }
  },
  "required": [
    "schema_version",
    "challenge_id",
    "nonce",
    "expires_at"
  ],
  "additionalProperties": false
}
